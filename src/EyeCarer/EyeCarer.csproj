<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>../../assets/EyeCarer.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>EyeCarer</AssemblyName>
    <Version>1.0.0</Version>
    <Product>EyeCarer</Product>
    <Authors>GampiXs</Authors>
    <Description>Customizable screen break reminders for Windows.</Description>
    <Copyright>Copyright (c) 2026 GampiXs</Copyright>
    <RepositoryUrl>https://github.com/GampiXs/EyeCarer</RepositoryUrl>
    <!-- WPF reads PerMonitorV2 from the manifest; the WinForms-only analyzer does not apply. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../assets/EyeCarer.ico" Link="EyeCarer.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../config.example.json" Link="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
